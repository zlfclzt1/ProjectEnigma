{
  "name": "mystery-guild-master",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "serve": "python3 -m http.server 4173",
    "test": "npm run test:legacy && npm run test:unit",
    "test:legacy": "node --test tests/*.test.mjs",
    "test:unit": "vitest run",
    "baseline:check": "node scripts/capture-v1-baselines.mjs --check",
    "baseline:write": "node scripts/capture-v1-baselines.mjs --write",
    "content:audit": "node scripts/audit-legacy-content.mjs --check",
    "content:audit:write": "node scripts/audit-legacy-content.mjs --write",
    "validate:content": "node --import tsx scripts/validate-content.ts",
    "simulate:rfc": "node scripts/simulate_ragefire_chasm.mjs 100000"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "dexie": "^4.4.5",
    "zod": "^4.5.4"
  }
}
