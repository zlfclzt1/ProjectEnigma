{
  "name": "mystery-guild-master",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "baseline:check": "node --import tsx scripts/simulate-dungeons.ts 100000 --check",
    "baseline:write": "node --import tsx scripts/simulate-dungeons.ts 100000 --write",
    "validate:content": "node --import tsx scripts/validate-content.ts",
    "item-stats:audit": "node --import tsx scripts/audit-item-stats.ts --check",
    "item-stats:audit:write": "node --import tsx scripts/audit-item-stats.ts --write",
    "loot-sources:audit": "node --import tsx scripts/audit-loot-sources.ts --check",
    "loot-sources:audit:write": "node --import tsx scripts/audit-loot-sources.ts --write",
    "progression:simulate": "node --import tsx scripts/simulate-progression.ts",
    "progression:baseline:check": "node --import tsx scripts/simulate-progression.ts --check",
    "progression:baseline:write": "node --import tsx scripts/simulate-progression.ts --write",
    "simulate:dungeons": "node --import tsx scripts/simulate-dungeons.ts 100000"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "dexie": "^4.4.5",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "zod": "^4.5.4"
  }
}
